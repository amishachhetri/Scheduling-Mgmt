PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Postgres connection string. Local dev: a local Postgres instance (e.g. postgresql://localhost:5432/photographer_dev).
# Production: your Vercel Postgres / Neon connection string (set in the Vercel dashboard, not here).
POSTGRES_URL=postgresql://localhost:5432/photographer_dev
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('yourpassword',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=

# Required in production — secures the Vercel Cron endpoints (/api/cron/daily, /api/cron/hourly)
# so only Vercel's own scheduled requests can trigger them. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not needed for local dev (node-cron runs in-process instead — see services/cron.js).
CRON_SECRET=

# Optional — powers the Portfolio media manager (photo/video uploads). Without these,
# the admin Portfolio tab shows a "not configured" state and the rest of the app works as normal.
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Google Calendar sync. Client ID/secret are entered in Settings, not here, but the
# OAuth redirect URI must be reachable at this exact URL and match what's configured in the
# Google Cloud Console. Defaults to the localhost dev value if unset.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/calendar/google/callback
# Optional — IANA timezone (e.g. America/New_York) used for Google Calendar event times.
# Defaults to the server process's own local timezone if unset.
GCAL_TIMEZONE=
